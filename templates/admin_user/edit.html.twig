{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1>Modifier {{ user.email }}</h1>
        {{ form_start(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.roles) }}
        {{ form_row(form.password, {label: 'Nouveau mot de passe (laisser vide pour conserver l\'ancien)'}) }}
        <button type="submit" class="btn btn-primary">Modifier</button>
        <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
