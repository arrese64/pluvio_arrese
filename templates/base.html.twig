<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PLUVIO{% endblock %}</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<!-- Barre de navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <span class="navbar-brand">PLUVIO</span>
        <div class="navbar-nav">
            <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
            {% if app.user %}
                <a class="nav-link" href="{{ path('app_table_niveau') }}">Niveaux de la cuve</a>
                <a class="nav-link" href="{{ path('app_table_pluvio') }}">Pluviométrie</a>
                <a class="nav-link" href="{{ path('app_graphs') }}">Graphiques</a>
            {% endif %}
        </div>
        <div class="navbar-nav ms-auto">
            {% if app.user %}
                <span class="navbar-text me-3">{{ app.user.email }}</span>
                <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
            {% endif %}
        </div>
    </div>
</nav>

<!-- Contenu principal -->
<div class="container mt-3">
    {% block body %}{% endblock %}
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>

